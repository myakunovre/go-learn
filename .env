SERVER_PORT=8080

# PostgreSQL CoreDB
CORE_DB_HOST=localhost
CORE_DB_PORT=5432
CORE_DB_USER=user
CORE_DB_PASSWORD=password
CORE_DB_NAME=postgres

# PostgreSQL OrderDB
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5433
ORDER_DB_USER=user
ORDER_DB_PASSWORD=password
ORDER_DB_NAME=postgres

# Redis для сервиса core (только авторизация)
CORE_REDIS_HOST=localhost
CORE_REDIS_PORT=6379
CORE_REDIS_DB=0
CORE_REDIS_PASSWORD=

# Redis для сервиса order (авторизация + заказы)
ORDER_REDIS_HOST=localhost
ORDER_REDIS_PORT=6379
ORDER_REDIS_DB=1
ORDER_REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092

# GRPC
CORE_GRPC_PORT=50051

# Gracefull Shutdown
SHUTDOWN_TIMEOUT=5